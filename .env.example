# Postgres (consumed by docker-compose.yml AND apps/server via dotenv)
POSTGRES_USER=kitchen
POSTGRES_PASSWORD=kitchen
POSTGRES_DB=kitchen
POSTGRES_PORT=5432

# Adminer database UI (docker-compose)
ADMINER_PORT=8080

# Meilisearch (recipe search). MEILI_URL points the app at the search engine;
# leave it unset to run without search. In dev the compose service publishes on
# MEILI_PORT (default 7700). In production compose the app reaches it in-network
# at http://meilisearch:7700, and MEILI_ENV=production requires a master key of
# at least 16 bytes — change MEILI_MASTER_KEY below.
MEILI_URL=http://localhost:7700
MEILI_PORT=7700
MEILI_MASTER_KEY=dev-meili-master-key

# Prisma / server connection string (host is localhost since Postgres is published on POSTGRES_PORT)
DATABASE_URL=postgresql://kitchen:kitchen@localhost:5432/kitchen

# Auth
JWT_SECRET=dev-secret-change-me
# Auth cookies get the `Secure` flag by default in production (requires HTTPS).

# Set to false to serve over plain HTTP (e.g. a LAN/homelab host without TLS);
# otherwise browsers drop the cookie and every request 401s.
COOKIE_SECURE=false

# Server: the API is the front door on port 3000 and proxies non-/api requests
# to the web server at WEB_URL. WEB_ORIGIN is the browser-facing origin (CORS).
SERVER_PORT=4000

# This is the address you will be accessing this service from. It could be https://yourdomain.app
WEB_ORIGIN=http://localhost:3000

WEB_URL=http://localhost:4000

# The web server's own SSR loaders make a same-container fetch back to the API
# (e.g. to prime a recipe's page title) — this is that internal address, the
# counterpart to WEB_URL above. Keep it as localhost + SERVER_PORT; behind a
# reverse proxy the public URL isn't reachable in a loopback fetch.
SERVER_URL=http://localhost:3000

# Public recipe library: points at a list.json index of community recipes users
# can browse and import. Relative file_location entries are resolved against this
# URL. Leave unset to use the official Mise public library; override to host your
# own.
# PUBLIC_LIBRARY_URL=https://raw.githubusercontent.com/sidhantpanda/mise-public/main/list.json

# App (docker compose): host port the bundled app is published on.
APP_PORT=3000

# Web: the frontend calls the API same-origin (in dev the API front door on 3000
# proxies the Vite web server; in prod the API is mounted into the web server).
# Set VITE_API_URL only to target a different origin.
# VITE_API_URL=
