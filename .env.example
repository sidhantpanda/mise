# Postgres (consumed by docker-compose.yml AND apps/server via dotenv)
POSTGRES_USER=kitchen
POSTGRES_PASSWORD=kitchen
POSTGRES_DB=kitchen
POSTGRES_PORT=5432

# Adminer database UI (docker-compose)
ADMINER_PORT=8080

# Prisma / server connection string (host is localhost since Postgres is published on POSTGRES_PORT)
DATABASE_URL=postgresql://kitchen:kitchen@localhost:5432/kitchen

# Auth
JWT_SECRET=dev-secret-change-me
# Auth cookies get the `Secure` flag by default in production (requires HTTPS).
# Set to false to serve over plain HTTP (e.g. a LAN/homelab host without TLS);
# otherwise browsers drop the cookie and every request 401s.
# COOKIE_SECURE=false

# Server: the API is the front door on port 3000 and proxies non-/api requests
# to the web server at WEB_URL. WEB_ORIGIN is the browser-facing origin (CORS).
SERVER_PORT=4000
WEB_ORIGIN=http://localhost:3000
WEB_URL=http://localhost:4000

# App (docker compose): host port the bundled app is published on.
APP_PORT=3000

# Web: the frontend calls the API same-origin (in dev the API front door on 3000
# proxies the Vite web server; in prod the API is mounted into the web server).
# Set VITE_API_URL only to target a different origin.
# VITE_API_URL=
