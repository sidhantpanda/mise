# ──────────────────────────────────────────────────────────────────────────────
# Mise configuration
#
# One variable is required to deploy: JWT_SECRET. Everything else has a working
# default — uncomment a line only to change it.
# ──────────────────────────────────────────────────────────────────────────────

# REQUIRED — signs login cookies. Generate one:  openssl rand -hex 32
JWT_SECRET=

# The URL you'll open Mise at (default http://localhost:3000). Its scheme also
# controls cookie security: an https:// origin gets Secure cookies, an http://
# origin (LAN / homelab without TLS) doesn't — no extra flag needed.
# WEB_ORIGIN=https://mise.example.com

# Host port the app is published on by compose.yml.
# APP_PORT=3000

# ── Optional overrides ────────────────────────────────────────────────────────

# Postgres credentials. Both compose files and the app default all three to
# "mise". In the production compose the database isn't published to the host,
# so the defaults are only reachable from inside the compose network.
# POSTGRES_USER=mise
# POSTGRES_PASSWORD=mise
# POSTGRES_DB=mise

# Meilisearch (recipe search) master key. Also internal-only in production
# compose; must be at least 16 bytes.
# MEILI_MASTER_KEY=mise-default-meili-master-key

# Force the auth cookie `Secure` flag on/off instead of inferring it from
# WEB_ORIGIN's scheme (e.g. HTTPS at the proxy but a plain-HTTP WEB_ORIGIN).
# COOKIE_SECURE=true

# Public recipe library: a list.json index of community recipes users can
# browse and import. Defaults to the official Mise library; point it at your
# own to self-host the catalog.
# PUBLIC_LIBRARY_URL=https://raw.githubusercontent.com/sidhantpanda/mise-public/main/list.json

# ── Local development (pnpm dev) ──────────────────────────────────────────────
# The dev defaults match compose.dev.yml, so none of these are needed either.

# Where the server finds Postgres when running on the host.
# DATABASE_URL=postgresql://mise:mise@localhost:5432/mise

# Host ports published by compose.dev.yml.
# POSTGRES_PORT=5432
# ADMINER_PORT=8080
# MEILI_PORT=7700

# Dev Meilisearch connection (defaults match compose.dev.yml; search degrades
# gracefully if Meilisearch isn't running).
# MEILI_URL=http://localhost:7700
# MEILI_MASTER_KEY=dev-meili-master-key

# The web app calls the API same-origin; set only to target a different origin
# at build time.
# VITE_API_URL=
