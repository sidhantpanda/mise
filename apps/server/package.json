{
  "name": "server",
  "private": true,
  "license": "Elastic-2.0",
  "type": "module",
  "exports": {
    "./app": "./dist/src/app.js"
  },
  "scripts": {
    "dev": "prisma generate && cross-env SERVER_PORT=3000 tsx watch src/index.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "cross-env NODE_ENV=production SERVER_PORT=3000 node dist/src/index.js",
    "db:create": "tsx src/db/createDatabase.ts",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "dotenv": "^17.0.0",
    "express": "^5.2.1",
    "fflate": "^0.8.3",
    "http-proxy-middleware": "^3.0.5",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "pg": "^8.13.0",
    "prisma": "^7.8.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.16.5",
    "@types/pg": "^8.11.10",
    "eslint": "^9.32.0",
    "globals": "^15.15.0",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.56.1"
  }
}
