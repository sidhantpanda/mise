{
  "name": "server",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "exports": {
    "./app": "./dist/src/app.js"
  },
  "scripts": {
    "dev": "prisma generate && cross-env SERVER_PORT=3000 tsx watch src/index.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "cross-env NODE_ENV=production SERVER_PORT=3000 node dist/src/index.js",
    "db:create": "tsx src/db/createDatabase.ts",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^3.0.3",
    "common": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "cross-env": "^7.0.3",
    "dotenv": "^17.4.2",
    "express": "^5.3.0",
    "fflate": "^0.8.3",
    "http-proxy-middleware": "^4.2.1",
    "jsonwebtoken": "^9.0.3",
    "meilisearch": "^0.58.0",
    "multer": "^2.5.0",
    "pg": "^8.23.1",
    "prisma": "^7.10.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2"
  }
}
