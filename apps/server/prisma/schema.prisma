// Pragmatic v1 schema — maps 1:1 to the web app's Schema.org shapes (see
// apps/web/src/lib/mock-data.ts). Recipe ingredients stay free-text string[],
// pantry uses a single quantity, one household is auto-created per user.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum HouseholdType {
  Household
  Restaurant
}

enum MemberRole {
  Owner
  Admin
  Member
  // Read-only within this household: sees everything, changes nothing. Distinct
  // from User.isReadOnly, which locks an entire account across every household.
  Viewer
}

enum MealType {
  Breakfast
  Lunch
  Dinner
  Snack
}

enum PantryLocation {
  Pantry
  Fridge
  Freezer
}

enum InvitationStatus {
  Pending
  Accepted
  Rejected
}

model User {
  id                String            @id @default(uuid())
  email             String            @unique
  displayName       String
  passwordHash      String
  avatarColor       String?
  // A read-only account: every mutating request is rejected, whichever
  // household it is acting in. Account-level too — no token creation, no new
  // households, no invites — so publishing its credentials stays safe.
  isReadOnly        Boolean           @default(false)
  activeHouseholdId String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  memberships       HouseholdMember[]
  createdHouseholds Household[]              @relation("HouseholdCreatedBy")
  createdRecipes    Recipe[]                 @relation("RecipeCreatedBy")
  accessTokens      AccessToken[]
  oauthCodes        OAuthAuthorizationCode[]
  oauthRefreshTokens OAuthRefreshToken[]
  activeHousehold   Household?               @relation("ActiveHousehold", fields: [activeHouseholdId], references: [id], onDelete: SetNull)
}

model Household {
  id             String            @id @default(uuid())
  name           String
  type           HouseholdType     @default(Household)
  createdById    String
  createdBy      User              @relation("HouseholdCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  members        HouseholdMember[]
  invitations    Invitation[]
  recipes        Recipe[]
  meals          PlannedMeal[]
  shopping       ShoppingItem[]
  pantry         PantryItem[]
  accessTokens   AccessToken[]
  oauthCodes     OAuthAuthorizationCode[]
  oauthRefreshTokens OAuthRefreshToken[]
  activeForUsers User[]            @relation("ActiveHousehold")
}

// A bearer credential for the API and the MCP endpoint. Created two ways: by the
// user in settings (a personal token they paste somewhere), or by the OAuth flow
// on behalf of a connected client — `oauthClientId` distinguishes the latter, and
// OAuth-issued tokens expire and are renewed with an OAuthRefreshToken.
model AccessToken {
  id            String       @id @default(uuid())
  userId        String
  householdId   String
  name          String
  tokenHash     String       @unique
  tokenPrefix   String
  scopes        String[]     @default(["read"])
  oauthClientId String?
  lastUsedAt    DateTime?
  expiresAt     DateTime?
  revokedAt     DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  household     Household    @relation(fields: [householdId], references: [id], onDelete: Cascade)
  oauthClient   OAuthClient? @relation(fields: [oauthClientId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([householdId])
}

// --- OAuth 2.1 authorization server (MCP "Connect" flow) ---
//
// Mise is both the resource server (/mcp) and the authorization server. MCP
// clients (Claude, ChatGPT) register themselves through Dynamic Client
// Registration, drive an authorization-code + PKCE flow against /oauth/authorize,
// and exchange the code at /oauth/token for an AccessToken above.

model OAuthClient {
  id                      String                   @id @default(uuid())
  clientName              String
  redirectUris            String[]
  grantTypes              String[]                 @default(["authorization_code", "refresh_token"])
  responseTypes           String[]                 @default(["code"])
  scopes                  String[]                 @default(["read", "write"])
  // "none" for public clients (PKCE only) — what Claude and ChatGPT register as.
  tokenEndpointAuthMethod String                   @default("none")
  clientSecretHash        String?
  clientUri               String?
  logoUri                 String?
  createdAt               DateTime                 @default(now())
  codes                   OAuthAuthorizationCode[]
  refreshTokens           OAuthRefreshToken[]
  accessTokens            AccessToken[]
}

// Single-use, short-lived code handed to the client's redirect_uri after the user
// approves the consent screen. Stored hashed; `consumedAt` makes replay detectable.
model OAuthAuthorizationCode {
  id                  String      @id @default(uuid())
  codeHash            String      @unique
  clientId            String
  userId              String
  householdId         String
  scopes              String[]
  redirectUri         String
  codeChallenge       String
  codeChallengeMethod String      @default("S256")
  resource            String?
  expiresAt           DateTime
  consumedAt          DateTime?
  createdAt           DateTime    @default(now())
  client              OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user                User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  household           Household   @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Rotating refresh token: redeeming one revokes it and its access token, and
// issues a fresh pair.
model OAuthRefreshToken {
  id            String      @id @default(uuid())
  tokenHash     String      @unique
  clientId      String
  userId        String
  householdId   String
  scopes        String[]
  accessTokenId String?
  expiresAt     DateTime
  revokedAt     DateTime?
  createdAt     DateTime    @default(now())
  client        OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  household     Household   @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model HouseholdMember {
  householdId String
  userId      String
  role        MemberRole @default(Member)
  joinedAt    DateTime   @default(now())
  household   Household  @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([householdId, userId])
}

model Invitation {
  id          String           @id @default(uuid())
  householdId String
  email       String
  role        MemberRole       @default(Member)
  status      InvitationStatus @default(Pending)
  sentAt      DateTime         @default(now())
  acceptedAt  DateTime?
  household   Household        @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([householdId, email])
}

model Recipe {
  id                 String        @id @default(uuid())
  householdId        String
  name               String
  description        String        @default("")
  image              String[]      @default([])
  authorName         String        @default("")
  datePublished      String        @default("")
  prepTime           String        @default("")
  cookTime           String        @default("")
  performTime        String        @default("")
  totalTime          String        @default("")
  cookingMethod      String        @default("")
  recipeYield        String        @default("")
  howToYield         Json?         @map("yield")
  recipeCategory     String        @default("")
  recipeCuisine      String        @default("")
  keywords           String[]      @default([])
  suitableForDiet    String[]      @default([])
  recipeIngredient   String[]      @default([])
  recipeInstructions Json          @default("[]")
  estimatedCost      Json?
  supply             Json?
  tool               Json?
  nutrition          Json?
  schemaJson         Json?
  ratingValue        Float?
  ratingCount        Int?
  createdById        String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  household          Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdBy          User?         @relation("RecipeCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  meals              PlannedMeal[]

  @@index([householdId])
  @@index([createdById])
}

model PlannedMeal {
  id          String    @id @default(uuid())
  householdId String
  date        String
  mealType    MealType
  recipeId    String?
  servings    Int       @default(1)
  assigneeId  String?
  createdAt   DateTime  @default(now())
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  recipe      Recipe?   @relation(fields: [recipeId], references: [id], onDelete: SetNull)

  @@index([householdId, date])
}

model ShoppingItem {
  id           String    @id @default(uuid())
  householdId  String
  name         String
  quantity     String    @default("")
  category     String    @default("")
  checked      Boolean   @default(false)
  fromRecipeId String?
  createdAt    DateTime  @default(now())
  household    Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId])
}

model PantryItem {
  id            String         @id @default(uuid())
  householdId   String
  name          String
  category      String         @default("")
  quantityValue Float          @default(0)
  quantityUnit  String         @default("")
  expires       String?
  location      PantryLocation @default(Pantry)
  createdAt     DateTime       @default(now())
  household     Household      @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId])
}
