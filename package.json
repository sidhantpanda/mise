{
  "name": "mise",
  "author": "Sidhant Panda",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26.13.1"
  },
  "scripts": {
    "dev:db": "docker compose -f compose.dev.yml up",
    "dev": "pnpm --filter common build && concurrently -n common,api,web -c yellow,green,blue \"pnpm --filter common dev\" \"pnpm --filter server dev\" \"pnpm --filter web dev\"",
    "docs:dev": "pnpm --filter docs dev",
    "docs:build": "pnpm --filter docs build",
    "build": "pnpm -r build",
    "start": "concurrently -n api,web -c green,blue \"pnpm --filter server start\" \"pnpm --filter web start\"",
    "preview": "pnpm --filter web preview",
    "lint": "pnpm -r lint",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project common --project server-unit --project web",
    "test:integration": "vitest run --project server-integration",
    "test:e2e": "pnpm build && playwright test",
    "test:e2e:nobuild": "playwright test",
    "test:coverage": "vitest run --coverage",
    "db:create": "pnpm --filter server db:create",
    "db:push": "pnpm --filter server db:push",
    "db:seed": "pnpm --filter server db:seed",
    "db:studio": "pnpm --filter server db:studio"
  },
  "dependencies": {
    "concurrently": "^10.0.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/supertest": "^7.2.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^5.1.0",
    "prettier": "^3.10.1",
    "supertest": "^7.3.2",
    "testcontainers": "^12.2.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.1.0"
  }
}
